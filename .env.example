# Secrets template for email-assistant.
# Copy this file to secrets/.env and replace the placeholders. secrets/ is
# gitignored as a whole directory, so the real file is never committed.
# Anthropic API key (`email-assistant` key).
EMAIL_ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_TOKEN=0000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Your numeric Telegram chat id (the only chat the bot answers).
TELEGRAM_CHAT_ID=000000000
